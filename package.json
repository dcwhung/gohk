{
    "name": "gohk",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "香港懷舊橫向動作 RPG 網頁遊戲（Phaser 3 + TypeScript + Vite）",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write ."
    },
    "dependencies": {
        "phaser": "3.90.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "5.0.5",
        "eslint": "10.12.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "prettier": "3.9.10",
        "typescript": "5.9.3",
        "typescript-eslint": "8.71.2",
        "vite": "8.3.4",
        "vitest": "5.0.5"
    },
    "engines": {
        "node": ">=22"
    }
}
